# Optional market data provider settings.
# Priority: FactSet -> Financial Modeling Prep -> Alpha Vantage -> yfinance -> manual/offline.
# Leave blank to run the pipeline with missing-data warnings.
FACTSET_API_KEY=
FACTSET_USERNAME=
FACTSET_PASSWORD=
FMP_API_KEY=
FINANCIAL_MODELING_PREP_API_KEY=
ALPHA_VANTAGE_API_KEY=
YFINANCE_ENABLED=true

# Google Finance scraping is intentionally not used as a production provider.
GOOGLE_FINANCE_EXPERIMENTAL=false

# Optional LLM extraction settings. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional source collection controls.
SOURCE_REQUEST_DELAY_SECONDS=2
SOURCE_DISCOVER_PDF_LINKS=true
SOURCE_DOWNLOAD_PDFS=false

# Dynamic company discovery controls.
DISCOVERY_ENABLE_LIVE_SOURCES=true
DISCOVERY_ENRICH_COMPANY_PROFILES=true
DISCOVERY_USE_CURATED_FALLBACK=true
DISCOVERY_MAX_COMPANIES_PER_RUN=80
DISCOVERY_NEW_COMPANIES_PER_RUN=7
DISCOVERY_DAILY_NEW_COMPANY_LIMIT=28
DISCOVERY_REMOTE_CSV_URLS=
DISCOVERY_EXTRA_COMPANIES_JSON=

# News and chart controls.
NEWS_DISCOVERY_ENABLED=true
NEWS_ITEMS_PER_COMPANY=5
NEWS_REQUEST_DELAY_SECONDS=1
