# Optional market data provider settings.
# Leave blank to run the pipeline with missing-data warnings.
YFINANCE_ENABLED=true

# Optional LLM extraction settings. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional source collection controls.
SOURCE_REQUEST_DELAY_SECONDS=2
SOURCE_DOWNLOAD_PDFS=false
